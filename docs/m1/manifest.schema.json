{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M1 bootstrap component manifest v1 (prototype subset)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "platform", "components", "executable", "arguments"],
  "properties": {
    "schema_version": {"const": 1},
    "version": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "platform": {"enum": ["windows-x86_64", "macos-aarch64", "macos-x86_64", "linux-x86_64"]},
    "components": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "url", "size_bytes", "unpacked_limit_bytes", "sha256"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
          "url": {"type": "string", "pattern": "^https://", "format": "uri"},
          "size_bytes": {"type": "integer", "minimum": 1},
          "unpacked_limit_bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "executable": {"type": "string", "minLength": 1},
    "arguments": {"type": "array", "items": {"type": "string"}}
  }
}
